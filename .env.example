# =============================================================================
# Forex Intelligence Lab — environment configuration
# Copy this file to .env and fill in local values. Never commit .env.
# MT5 credentials must NEVER appear in frontend code.
# =============================================================================

# --- Application ---
APP_NAME=Forex Intelligence Lab
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8088
APP_SECRET_KEY=change-me-to-a-long-random-string
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://forextradingai.test

# --- Dashboard authentication (required before public exposure) ---
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=change-me-strong-password
JWT_EXPIRE_MINUTES=720

# --- Database (local PostgreSQL — Docker is not used) ---
    DATABASE_URL=postgresql+psycopg://orakool@localhost:5432/forex_intelligence

# --- MT5 / FBS ---
# Modes:
#   mock     — synthetic data for local development (macOS / CI / no terminal)
#   official — MetaTrader5 Python package on the same Windows machine as MT5
#   agent    — backend receives data from mt5-agent running next to MT5
#   bridge   — macOS MetaTrader 5.app (Wine) via mt5-mac-bridge + rpyc
#              See docs/MT5_MAC_BRIDGE.md. Does not replace official/agent.
MT5_MODE=mock
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Windows path to terminal64.exe. On macOS bridge mode leave the Wine path:
# MT5_TERMINAL_PATH=C:/Program Files/MetaTrader 5/terminal64.exe
MT5_TERMINAL_PATH=
MT5_TIMEOUT_MS=60000
# Used only when MT5_MODE=bridge (macOS Wine rpyc server)
MT5_BRIDGE_HOST=127.0.0.1
MT5_BRIDGE_PORT=18813

# Shared secret for mt5-agent → FastAPI ingest (MT5_MODE=agent)
AGENT_API_KEY=change-me-agent-api-key

# Shared secret between Laravel and FastAPI. Never send this from the browser.
SAAS_API_KEY=local-fil-saas-key-2026

# --- Collection ---
COLLECTOR_INTERVAL_SECONDS=5
DEFAULT_TIMEFRAMES=M5
SEED_HISTORY_DAYS=30
# Collector auto-imports SEED_HISTORY_DAYS for thin monitored instruments
# via the active MT5 adapter (bridge/official/mock). Set false to disable.
AUTO_BACKFILL=true

# --- Research / ML ---
# Predictions are research-only. Never treated as trade orders.
PREDICTION_THRESHOLD=0.55
SPREAD_COST_PIPS=0.8
TRANSACTION_COST_PIPS=0.2

# --- Alerts ---
STALE_CANDLE_SECONDS=180
LARGE_SPREAD_PIPS=5.0
ALERT_PROBABILITY_THRESHOLD=0.70

# --- Frontend (Vite) ---
# Leave empty for local npm run dev (Vite proxies /api and /ws to the backend).
VITE_API_BASE=
VITE_WS_BASE=
